<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The core makes Client-Server API calls over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PigeonApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- networkSecurityConfig: HTTPS only (res/xml/network_security_config.xml).
             The debug build swaps in src/debug/res/xml/network_security_config.xml,
             which also allows http:// to 10.0.2.2 and localhost only, so the
             emulator can reach a local dev homeserver at http://10.0.2.2:8008.
             A release build never sends tokens over cleartext.
             allowBackup=false: the encrypted session store must not be included
             in cloud/adb backups. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
